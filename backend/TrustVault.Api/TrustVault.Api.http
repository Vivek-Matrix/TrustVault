@TrustVault.Api_HostAddress = http://localhost:5106

### Sign in as an administrator or managed member
POST {{TrustVault.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "administrator@example.test",
  "password": "SetInLocalSecretStore"
}

###

### List members (Administrator only)
GET {{TrustVault.Api_HostAddress}}/api/admin/members
Accept: application/json
Authorization: Bearer {{accessToken}}

###

### Add member (Administrator only; temporary password is returned once)
POST {{TrustVault.Api_HostAddress}}/api/admin/members
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "email": "new-member@example.test",
  "role": "Viewer"
}

###

GET {{TrustVault.Api_HostAddress}}/api/system/health
Accept: application/json

###

GET {{TrustVault.Api_HostAddress}}/api/system/whoami
Accept: application/json
Authorization: Bearer {{accessToken}}

###
